#!/bin/sh
# Run one review as a subagent, the prompt read from a file and the reviewer's
# final message written to the review file.
#
# With OPENAI_API_KEY set, the reviewer is a Pi subagent on an OpenAI model
# (REVIEW_MODEL, default openai/gpt-5.3-codex) with read-only file tools and
# bash. Without it, the reviewer is `codex exec --sandbox read-only` on the
# `codex login` account.
#
# Inside tmux the review runs in its own pane beside the caller's, in an
# interactive bash so it gets the user's .bashrc environment (DISPLAY among
# it), and the caller blocks until the pane finishes; outside tmux it runs in place. Either way
# the exit status is the reviewer's, or 124 when the thirty-minute limit is hit.
#
# It refuses, with exit 2, a prompt that lacks a part the skill makes fixed: the
# `# Na.` title instruction, the Sources list, the three closing sentences. On
# a reviewer exit of 0 it strips trailing whitespace and trailing blank lines
# from the review file and ends it with a newline, as end-of-file-fixer wants.
set -eu
[ "$#" -eq 2 ] || { echo "usage: $0 <review file> <prompt file>" >&2; exit 2; }

refuse() { echo "run-review: prompt $REVIEW_PROMPT: $1; not started" >&2; exit 2; }
REVIEW_PROMPT="$2"
[ -r "$REVIEW_PROMPT" ] || refuse "unreadable"
# The pattern is literal backquote, hash, digits, 'a. '.
# shellcheck disable=SC2016
grep -Eq '`# [0-9]+a\. ' "$REVIEW_PROMPT" || refuse "no '# Na.' title instruction"
# The Sources list: the brief's 'Read them against:' line, then a '- ' item.
awk '/^Read them against:/ { s = 1; next }
  s && /^[[:space:]]*$/ { next }
  s { exit !/^- / }
  END { if (!s) exit 1 }' "$REVIEW_PROMPT" ||
  refuse "no Sources list after 'Read them against:'"
closing='If nothing is above low severity, say so plainly.
Do not edit files.
Produce a markdown report ordered by severity, citing every file as the Citations section says.'
[ "$(grep -v '^[[:space:]]*$' "$REVIEW_PROMPT" | tail -n 3)" = "$closing" ] ||
  refuse "does not end with the three closing sentences"

export REVIEW_OUT="$1" REVIEW_PROMPT="$2" REVIEW_LIMIT=1800
export REVIEW_MODEL="${REVIEW_MODEL:-openai/gpt-5.3-codex}"
# Paths travel as environment, not spliced into the command, so no quoting.
# The commands expand later, in the shell that runs them.
# shellcheck disable=SC2016
if [ -n "${OPENAI_API_KEY:-}" ]; then
  echo "run-review: Pi subagent on $REVIEW_MODEL" >&2
  review='timeout "$REVIEW_LIMIT" pi -p --no-session -ne -ns -np \
    --model "$REVIEW_MODEL" --tools read,grep,find,ls,bash \
    < "$REVIEW_PROMPT" > "$REVIEW_OUT"'
else
  echo "run-review: no OPENAI_API_KEY, codex exec" >&2
  review='timeout "$REVIEW_LIMIT" codex exec --sandbox read-only \
    -o "$REVIEW_OUT" - < "$REVIEW_PROMPT"'
fi

# On success: no trailing whitespace or trailing blank lines, and a final
# newline, which awk's print always writes.
finish() {
  if [ "$1" -eq 0 ] && [ -f "$REVIEW_OUT" ]; then
    tidy=$(mktemp)
    awk '{ sub(/[[:space:]]+$/, "") }
      /^$/ { blank++; next }
      { while (blank) { print ""; blank-- } print }' "$REVIEW_OUT" > "$tidy" &&
      cat "$tidy" > "$REVIEW_OUT"
    rm -f "$tidy"
  fi
  exit "$1"
}

if [ -z "${TMUX:-}" ]; then
  status=0
  sh -c "$review" || status=$?
  finish "$status"
fi

export REVIEW_CHANNEL="review-loop-$$" REVIEW_STATUS REVIEW_KEY
REVIEW_STATUS=$(mktemp)
# A new pane gets the tmux server's environment, not ours; the key goes over
# in a mode-0600 file rather than on a command line that ps would show.
REVIEW_KEY=$(mktemp)
trap 'rm -f "$REVIEW_STATUS" "$REVIEW_KEY"' EXIT
printf '%s' "${OPENAI_API_KEY:-}" > "$REVIEW_KEY"
# The pane command expands in the pane, not here.
# shellcheck disable=SC2016
tmux split-window -d ${TMUX_PANE:+-t "$TMUX_PANE"} -c "$PWD" \
  -e "REVIEW_OUT=$REVIEW_OUT" -e "REVIEW_PROMPT=$REVIEW_PROMPT" \
  -e "REVIEW_LIMIT=$REVIEW_LIMIT" -e "REVIEW_MODEL=$REVIEW_MODEL" \
  -e "REVIEW_STATUS=$REVIEW_STATUS" -e "REVIEW_CHANNEL=$REVIEW_CHANNEL" \
  -e "REVIEW_KEY=$REVIEW_KEY" \
  -e "REVIEW_PANE=[ -s \"\$REVIEW_KEY\" ] && export OPENAI_API_KEY=\$(cat \"\$REVIEW_KEY\"); ($review); echo \$? > \"\$REVIEW_STATUS\"; tmux wait-for -S \"\$REVIEW_CHANNEL\"" \
  'exec bash -ic "$REVIEW_PANE"'
# The pane signals even when the reviewer fails, exits or times out, since it
# runs in a subshell; the outer limit only covers a pane killed by hand.
timeout $((REVIEW_LIMIT + 60)) tmux wait-for "$REVIEW_CHANNEL" || exit 124
finish "$(cat "$REVIEW_STATUS")"
