#!/bin/sh
# cron-pickup <crontab file> [<wrapper>...]: install a team's crontab, the one
# its wiki publishes (<root>/wiki/crontab, the lead's content), into a marked
# block of the invoking user's crontab (AW-Q176, CS-Q83: the operator, 22 Nov
# 2026 22:14 and 23 Nov 22:31).
#
# The block runs from "# BEGIN team <file>" to "# END team <file>", <file> the
# crontab file's absolute path, so several teams share one crontab. A rerun
# replaces the block whole and leaves every other line as it was.
#
# Without a wrapper (a cloud sandbox, or a jail running its own cron), each
# line goes in as written. With one (the host's cron for a jail sandbox, e.g.
# `jexec -U <user> <jail>`), each command becomes `<wrapper> sh -c '<command>'`,
# so it runs inside the sandbox, never on the host: the wiki is written by
# agents (rules.md rule 3).
#
# Refused, with nothing installed: a line setting a variable (NAME=...), which
# would change the whole crontab's environment; a schedule that is not five
# fields or one of @hourly @daily @midnight @weekly @monthly @yearly
# @annually; a command holding an unescaped %, where cron would cut the line;
# a line starting "# BEGIN team" or "# END team", which would fake a marker
# (AW-Q179). Also refused: a file path holding a newline or a backslash
# (AW-Q178), and a wrapper word holding a space or tab (AW-Q181). The markers
# and the wrapper reach awk through the environment, never through -v, which
# would turn \n into a newline (AW-Q178).
# A failed read of the current crontab is never taken as an empty one.
#
# Remove the block by hand with crontab -e.
set -u
say() { printf 'cron-pickup: %s\n' "$*" >&2; }
[ $# -ge 1 ] || { say "usage: cron-pickup <crontab file> [<wrapper>...]"; exit 2; }
file=$1
shift
[ -f "$file" ] && [ -r "$file" ] || { say "cannot read $file"; exit 1; }
file=$(cd "$(dirname "$file")" && pwd)/$(basename "$file")
case $file in *"
"* | *\\*) say "the file's path holds a newline or a backslash"; exit 1 ;; esac
for w in "$@"; do
	case $w in *[[:space:]]* | '') say "a wrapper word is empty or holds a space: '$w'"; exit 1 ;; esac
done
CP_WRAP="$*" CP_BEGIN="# BEGIN team $file" CP_END="# END team $file"
export CP_WRAP CP_BEGIN CP_END
tmp=$(mktemp -d "${TMPDIR:-/tmp}/cron-pickup.XXXXXX") || { say "mktemp failed"; exit 1; }
trap 'rm -rf "$tmp"' EXIT

# The block, or the first refusal.
if ! awk '
	function quote(s) { gsub(/\047/, "\047\\\047\047", s); return "\047" s "\047" }
	function refuse(why) { printf "cron-pickup: line %d refused: %s: %s\n", NR, why, $0 > "/dev/stderr"; bad = 1 }
	BEGIN { wrap = ENVIRON["CP_WRAP"]; print ENVIRON["CP_BEGIN"] }
	/^[ \t]*$/ { next }
	/^[ \t]*# (BEGIN|END) team/ { refuse("a line that looks like a marker"); next }
	/^[ \t]*#/ { print; next }
	/^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*=/ { refuse("a variable"); next }
	{
		line = $0
		sub(/^[ \t]+/, "", line)
		if (line ~ /^@/) {
			n = 1
			if (line !~ /^@(hourly|daily|midnight|weekly|monthly|yearly|annually)[ \t]/) { refuse("an unknown schedule word"); next }
		} else n = 5
		sched = ""
		for (i = 1; i <= n; i++) {
			if (!match(line, /^[^ \t]+[ \t]+/)) { refuse("no command after the schedule"); next }
			field = substr(line, 1, RLENGTH)
			line = substr(line, RLENGTH + 1)
			f = field
			sub(/[ \t]+$/, "", f)
			if (n == 5 && f !~ /^[0-9A-Za-z*\/,-]+$/) { refuse("a schedule field that is not one: " f); next }
			sched = sched f " "
		}
		if (line == "") { refuse("no command"); next }
		t = line
		gsub(/\\\\/, "", t)
		gsub(/\\%/, "", t)
		if (t ~ /%/) { refuse("an unescaped %"); next }
		print sched (wrap == "" ? line : wrap " sh -c " quote(line))
	}
	END { print ENVIRON["CP_END"]; exit bad }
' "$file" > "$tmp/block"; then
	say "nothing installed"
	exit 1
fi

# The current crontab: none is empty; any other failure stops here.
if crontab -l > "$tmp/current" 2> "$tmp/err"; then :
elif grep -q 'no crontab for' "$tmp/err"; then : > "$tmp/current"
else
	say "cannot read the current crontab: $(cat "$tmp/err")"
	exit 1
fi

# Every other line kept, the old block dropped, the new one appended.
awk '
	$0 == ENVIRON["CP_BEGIN"] { skip = 1; next }
	skip && $0 == ENVIRON["CP_END"] { skip = 0; next }
	!skip { print }
' "$tmp/current" > "$tmp/new" && cat "$tmp/block" >> "$tmp/new" ||
	{ say "cannot build the new crontab"; exit 1; }
crontab "$tmp/new" || { say "crontab refused the new table; the old one stays"; exit 1; }

# Read back: the block installed, yes or no.
crontab -l > "$tmp/after" 2> "$tmp/err" || { say "installed, but the read back failed: $(cat "$tmp/err")"; exit 1; }
awk '
	$0 == ENVIRON["CP_BEGIN"] { on = 1 } on { print } on && $0 == ENVIRON["CP_END"] { exit }
' "$tmp/after" | cmp -s - "$tmp/block" ||
	{ say "installed, but the read back does not hold the block"; exit 1; }
echo "cron-pickup: $(($(wc -l < "$tmp/block") - 2)) line(s) installed from $file"
