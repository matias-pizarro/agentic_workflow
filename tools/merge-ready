#!/usr/bin/env sh
# Is a seat's branch ready to merge into integration? (rules.md rule 9; RT2-Q5)
#
# Usage: merge-ready <worktree> <live-run commit> <code path>...
#
# Exits 1, naming every reason, when the integration branch is not an
# ancestor of the worktree's HEAD (merge integration in first), or when the
# branch's own change to a code path follows the commit the live checks last
# ran on (rerun them live). The branch's own changes are HEAD compared with
# integration merged into the live run's commit (git merge-tree, git 2.38),
# so what merging integration in brought is not counted (MR-Q1). When that
# merge conflicts, its tree holds conflict markers, so a conflicted file
# under the code paths differs from HEAD and counts; one elsewhere does not
# (MRCR-Q1). A failed read is a refusal, never a pass. Exit 2 on a
# usage error. The lead runs it before authorising a merge.
#
# It also warns, without changing the exit status, of each ticket the branch
# changed (.scratch/<topic>/issues/*.md, against integration) whose
# **Status:** line at HEAD is not done; the ready report answers each
# (RT3-Q10).
set -eu
set -o pipefail
nl='
'

[ $# -ge 3 ] || { echo "usage: merge-ready <worktree> <live-run commit> <code path>..." >&2; exit 2; }
wt=$1 live=$2
shift 2

why=''
rc=0
git -C "$wt" merge-base --is-ancestor integration HEAD || rc=$?
case $rc in
0) ;;
1) why="$why
- integration is not in HEAD: merge integration into the branch first" ;;
*) echo "merge-ready: cannot compare integration with HEAD in $wt" >&2; exit 1 ;;
esac

rc=0
merged=$(git -C "$wt" merge-tree --write-tree --no-messages "$live" integration) || rc=$?
# Exit 1 is a conflict only when a tree id comes first; a ref git cannot read
# also exits 1, printing no tree.
case ${merged%%"$nl"*} in '' | *[!0-9a-f]*) rc=2 ;; esac
case $rc in
0 | 1) changed=$(git -C "$wt" diff --name-only "${merged%%"$nl"*}" HEAD -- "$@") ||
    { echo "merge-ready: cannot diff the live run with integration against HEAD in $wt" >&2; exit 1; } ;;
*) echo "merge-ready: cannot merge integration into $live in $wt" >&2; exit 1 ;;
esac
[ -z "$changed" ] || why="$why
- changed since the live run at $live: $(printf '%s' "$changed" | tr '\n' ' ')
  run them live again"

tickets=$(git -C "$wt" diff --name-only --diff-filter=d integration...HEAD -- '.scratch/*/issues/*.md') ||
  { echo "merge-ready: cannot list the tickets the branch changed in $wt" >&2; exit 1; }
for t in $tickets; do
  status=$(git -C "$wt" show "HEAD:$t" | sed -n 's/^\*\*Status:\*\* *//p' | head -1) ||
    { echo "merge-ready: cannot read $t at HEAD in $wt" >&2; exit 1; }
  case $status in done | 'done '* | done.*) ;; *) echo "merge-ready: warning: $t says Status: ${status:-(none)}, not done" ;; esac
done

if [ -n "$why" ]; then
  echo "merge-ready: not ready ($wt):$why"
  exit 1
fi
echo "merge-ready: ready: integration is in $wt's HEAD, and $* unchanged since the live run at $live"
