#!/bin/sh
# Are the global skills behind their sources? (rules.md, Team mechanics; CS-Q112)
#
# Usage: skills-check
#
# Read-only. For each skill in the global lock file (~/.agents/.skill-lock.json;
# SKILLS_LOCK overrides), compares its skillFolderHash, the git tree of its
# folder when installed, with the same folder at its source's default branch,
# read by one shallow, blob-less clone per source. Prints each skill behind its
# source, one per line: "behind: <skill> (<source>)". Exits 0 when none is
# behind, 1 when any is, 2 when a read fails (a failed read is never taken as
# up to date). Updating is `npx skills update -g`, on the operator's go.
set -u
GIT_TERMINAL_PROMPT=0 # a source that asks for a login fails, never waits
export GIT_TERMINAL_PROMPT
lock=${SKILLS_LOCK:-$HOME/.agents/.skill-lock.json}
[ -r "$lock" ] || { echo "skills-check: cannot read $lock" >&2; exit 2; }
command -v jq > /dev/null || { echo "skills-check: no jq" >&2; exit 2; }
tab=$(printf '\t')
rows=$(jq -r '.skills | to_entries[] | [.key, .value.sourceUrl, .value.skillPath, .value.skillFolderHash] | @tsv' "$lock") ||
  { echo "skills-check: cannot parse $lock" >&2; exit 2; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/skills-check.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
rc=0 n=0 behind=0
for url in $(printf '%s\n' "$rows" | cut -f2 | sort -u); do
  dir=$tmp/$(printf '%s' "$url" | cksum | cut -d' ' -f1)
  if ! git clone -q --depth 1 --filter=blob:none --no-checkout "$url" "$dir" 2> "$tmp/err"; then
    echo "skills-check: cannot read $url: $(head -1 "$tmp/err")" >&2
    rc=2
    continue
  fi
  while IFS="$tab" read -r name src path hash; do
    [ "$src" = "$url" ] || continue
    n=$((n + 1))
    folder=$(dirname "$path")
    now=$(git -C "$dir" rev-parse -q --verify "HEAD:$folder") || {
      echo "behind: $name ($url: $folder no longer at its default branch)"
      behind=$((behind + 1))
      continue
    }
    [ "$now" = "$hash" ] || { echo "behind: $name ($url)"; behind=$((behind + 1)); }
  done << EOF
$rows
EOF
done
[ "$rc" = 0 ] || { echo "skills-check: $behind behind among the skills read; some sources unread" >&2; exit 2; }
echo "skills-check: $behind of $n behind"
[ "$behind" = 0 ]
