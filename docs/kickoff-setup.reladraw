// Kickoff, before the lead starts: each step, on your own host and in a
// sandbox session, side by side (docs/kickoff.md). Three kinds of line:
// "do", an action for the operator, starting with a verb; "cmd", a command to
// type, in a black box whose text can be selected and copied from the SVG
// opened in a browser; "note", what happens or why, in small muted text.
diagram  title: "Kickoff: before the lead starts"

style  step  fill: theme-primary-subtle  border: theme-primary                    corners: sharp
style  do    shape: none
style  note  shape: none                 text: (size: small, color: theme-muted)
style  cmd   fill: #000000               border: #555555                          corners: sharp  text: (color: #e8e8e8)

// 0. Enter
node  s0      "0. Enter" (inside top, size: large)                                                                                                    shape: none  layout: row (gap: wide, align-children: top)
node  s0.h    "On your own host" (outside top, size: large)                                                                                           style: step  layout: column (align-children: left, gap: tight)  width: s3.h  gather-children: left
node  s0.h.a  "⌨️ Open a shell on your host." (wrap: 60)                                                                                              style: do
node  s0.s    "In a sandbox session" (outside top, size: large)                                                                                       style: step  layout: column (align-children: left, gap: tight)  width: s4.s  gather-children: left
node  s0.s.a  "⌨️ Once per project, on the sandbox host, create the project:" (wrap: 60)                                                              style: do
node  s0.s.b  "sandbox project create <project> --repo <src remote> --repo <wiki remote>"                                                             style: cmd
node  s0.s.c  "It prints one deploy key per repository." (wrap: 70)                                                                                   style: note
node  s0.s.d  "⌨️ Add each key to its repository on the forge, as a deploy key (on GitHub: the repository's Settings, then Deploy keys)." (wrap: 60)  style: do
node  s0.s.e  "⌨️ Each time you start work, on the sandbox host, start a session:" (wrap: 60)                                                         style: do
node  s0.s.f  "sandbox start -p <project> -s <session>"                                                                                               style: cmd
node  s0.s.g  "You are now in tmux, in the session's workspace. That workspace is <root> in every step below." (wrap: 70)                             style: note

// 1. Pi, its packages, git, tmux
node  s1      "1. Pi, its packages, git, tmux" (inside top, size: large)                                              shape: none  layout: row (gap: wide, align-children: top)       below s0     left even with s0
node  s1.h    "On your own host" (outside top, size: large)                                                           style: step  layout: column (align-children: left, gap: tight)  width: s3.h  gather-children: left
node  s1.h.a  "⌨️ Install pi, git and tmux; on FreeBSD, follow the sandbox project's docs/install-pi.md." (wrap: 60)  style: do
node  s1.h.b  "⌨️ Install pi's subagents extension:" (wrap: 60)                                                       style: do
node  s1.h.c  "pi install npm:pi-subagents"                                                                           style: cmd
node  s1.s    "In a sandbox session" (outside top, size: large)                                                       style: step  layout: column (align-children: left, gap: tight)  width: s4.s  gather-children: left
node  s1.s.a  "⚙️ Nothing to do: the sandbox comes with pi, its packages, git and tmux." (wrap: 70)                   style: note

// 2. Logins and the reviewer
node  s2      "2. Logins and the reviewer" (inside top, size: large)                                                                                                                  shape: none  layout: row (gap: wide, align-children: top)       below s1     left even with s0
node  s2.h    "On your own host" (outside top, size: large)                                                                                                                           style: step  layout: column (align-children: left, gap: tight)  width: s3.h  gather-children: left
node  s2.h.a  "⌨️ Log pi in to Claude, as for any use of pi." (wrap: 60)                                                                                                              style: do
node  s2.h.b  "⌨️ Log the Codex CLI in to your ChatGPT account, for reviews:" (wrap: 60)                                                                                              style: do
node  s2.h.c  "codex login"                                                                                                                                                           style: cmd
node  s2.h.d  "An OPENAI_API_KEY in your environment works for reviews instead." (wrap: 70)                                                                                           style: note
node  s2.h.e  "⌨️ Check one of the two:" (wrap: 60)                                                                                                                                   style: do
node  s2.h.f  "codex login status"                                                                                                                                                    style: cmd
node  s2.h.g  "echo $OPENAI_API_KEY"                                                                                                                                                  style: cmd
node  s2.s    "In a sandbox session" (outside top, size: large)                                                                                                                       style: step  layout: column (align-children: left, gap: tight)  width: s4.s  gather-children: left
node  s2.s.a  "⌨️ On the host, if there is no token in /agents/users/<user>/credentials/teams/<project>/<session>/env or if it's stale, generate a fresh one by running:" (wrap: 60)  style: do
node  s2.s.b  "claude setup-token"                                                                                                                                                    style: cmd
node  s2.s.c  "⌨️ Put the token in /agents/users/<user>/credentials/teams/<project>/<session>/env:" (wrap: 60)                                                                        style: do
node  s2.s.d  "CLAUDE_CODE_OAUTH_TOKEN=<claude_oauth_token>"                                                                                                                          style: cmd
node  s2.s.e  "⌨️ In the sandbox, log the Codex CLI in to your ChatGPT account, for reviews:" (wrap: 60)                                                                              style: do
node  s2.s.f  "codex login --device-auth"                                                                                                                                             style: cmd
node  s2.s.g  "⌨️ Log pi in to the same account, for its GPT models and web search: inside pi, type this, then choose openai-codex:" (wrap: 60)                                       style: do
node  s2.s.h  "/login"                                                                                                                                                                style: cmd

// 3. Skills
node  s3      "3. Skills" (inside top, size: large)                                                                                                                                                                                             shape: none  layout: row (gap: wide, align-children: top)       below s2               left even with s0
node  s3.h    "On your own host" (outside top, size: large)                                                                                                                                                                                     style: step  layout: column (align-children: left, gap: tight)  gather-children: left
node  s3.h.a  "⌨️ Install the skills:" (wrap: 60)                                                                                                                                                                                               style: do
node  s3.h.b  "npx -y skills@latest add mattpocock/skills -g -a pi -y --skill chief-of-staff grill-with-docs \\ / grilling to-spec to-tickets implement implement-spec code-review tdd retro writing-for-agents domain-modeling" (align: left)  style: cmd
node  s3.h.c  "npx -y skills@latest add matias-pizarro/agentic_workflow -g -a pi -y --skill review-loop"                                                                                                                                        style: cmd
node  s3.h.d  "npx -y skills@latest add humanlayer/skills -g -a pi -y --skill show-me"                                                                                                                                                          style: cmd
node  s3.h.e  "⌨️ Check that review-loop is v1.0.0 or later: this must print a number above 0:" (wrap: 60)                                                                                                                                      style: do
node  s3.h.f  "grep -c DRIFT ~/.agents/skills/review-loop/SKILL.md"                                                                                                                                                                             style: cmd
node  s3.s    "In a sandbox session" (outside top, size: large)                                                                                                                                                                                 style: step  layout: column (align-children: left, gap: tight)  width: s4.s            gather-children: left
node  s3.s.a  "⚙️ Nothing to do: the first sandbox start installs the skills listed in the sandbox tooling's skills-lock.json." (wrap: 70)                                                                                                      style: note

// 4. Lay out <root>
node  s4      "4. Lay out <root>" (inside top, size: large)                                                                                                                    shape: none  layout: row (gap: wide, align-children: top)       below s3               left even with s0
node  s4.h    "On your own host" (outside top, size: large)                                                                                                                    style: step  layout: column (align-children: left, gap: tight)  width: s3.h            gather-children: left
node  s4.h.a  "⌨️ In <root>, with src already cloned there, run:" (wrap: 60)                                                                                                   style: do
node  s4.h.b  "git clone --branch v2.25.1 https://github.com/matias-pizarro/agentic_workflow.git"                                                                              style: cmd
node  s4.h.c  "mkdir worktrees html"                                                                                                                                           style: cmd
node  s4.h.d  "git init wiki"                                                                                                                                                  style: cmd
node  s4.h.e  "Or clone the wiki's private remote in place of git init." (wrap: 70)                                                                                            style: note
node  s4.h.f  "⌨️ Install the wiki's commit guard:" (wrap: 60)                                                                                                                 style: do
node  s4.h.g  "ln -s ../../../agentic_workflow/tools/wiki-pre-commit wiki/.git/hooks/pre-commit"                                                                               style: cmd
node  s4.h.h  "It refuses a commit that empties a file by accident." (wrap: 70)                                                                                                style: note
node  s4.h.i  "⌨️ Later, to move to a newer release once its CHANGELOG.md says what it asks:" (wrap: 60)                                                                       style: do
node  s4.h.j  "git -C agentic_workflow checkout <tag>"                                                                                                                         style: cmd
node  s4.s    "In a sandbox session" (outside top, size: large)                                                                                                                style: step  layout: column (align-children: left, gap: tight)  gather-children: left
node  s4.s.a  "⌨️ In the session's tmux, run this once, with your project's two repository addresses:" (wrap: 60)                                                              style: do
node  s4.s.b  "/sandbox/agent-defaults/src/scripts/sandbox-team-root <src remote> <wiki remote>"                                                                               style: cmd
node  s4.s.c  "It clones src, the wiki and agentic_workflow into <root>, makes worktrees/ and html/, and installs both commit guards: step 6's guard is done too." (wrap: 70)  style: note

// 5. src's agent docs
node  s5      "5. src's agent docs" (inside top, size: large)                                                                shape: none  layout: row (gap: wide, align-children: top)       below s4     left even with s0
node  s5.h    "On your own host" (outside top, size: large)                                                                  style: step  layout: column (align-children: left, gap: tight)  width: s3.h  gather-children: left
node  s5.h.a  "⌨️ Write src's agent docs, which kickoff.md lists, or have a seat draft them once the lead runs." (wrap: 60)  style: do
node  s5.s    "In a sandbox session" (outside top, size: large)                                                              style: step  layout: column (align-children: left, gap: tight)  width: s4.s  gather-children: left
node  s5.s.a  "⌨️ Write src's agent docs, which kickoff.md lists, or have a seat draft them once the lead runs." (wrap: 60)  style: do

// 6. The guards and prompt templates
node  s6       "6. The guards and prompt templates" (inside top, size: large)                                                                                                                            shape: none  layout: row (gap: wide, align-children: top)       below s5     left even with s0
node  s6.h     "On your own host" (outside top, size: large)                                                                                                                                             style: step  layout: column (align-children: left, gap: tight)  width: s3.h  gather-children: left
node  s6.h.a   "⌨️ Install the lead's commit guard:" (wrap: 60)                                                                                                                                          style: do
node  s6.h.b   "ln -s ../../../agentic_workflow/tools/src-pre-commit <root>/src/.git/hooks/pre-commit"                                                                                                   style: cmd
node  s6.h.b1  "⌨️ If it says \"File exists\", the pre-commit tool already installed its hook there: keep that hook as pre-commit.generated, which the guard runs, then run the link again:" (wrap: 60)  style: do
node  s6.h.b2  "mv -n <root>/src/.git/hooks/pre-commit <root>/src/.git/hooks/pre-commit.generated"                                                                                                       style: cmd
node  s6.h.c   "If the pre-commit tool installed no hooks in src, copy the file instead of linking it, make it executable, and delete its last line." (wrap: 70)                                         style: note
node  s6.h.d   "⌨️ Install the agents' guards and prompt templates:" (wrap: 60)                                                                                                                          style: do
node  s6.h.e   "cp -n ~/.pi/agent/settings.json ~/.pi/agent/settings.json.bak-guards"                                                                                                                    style: cmd
node  s6.h.f   "node <root>/agentic_workflow/tools/extensions/install.mjs"                                                                                                                               style: cmd
node  s6.h.g   "Run the second command again after each new release." (wrap: 70)                                                                                                                         style: note
node  s6.s     "In a sandbox session" (outside top, size: large)                                                                                                                                         style: step  layout: column (align-children: left, gap: tight)  width: s4.s  gather-children: left
node  s6.s.a   "⚙️ Nothing to do: step 4's command installed the commit guards, and every sandbox start installs the agents' guards and templates." (wrap: 70)                                           style: note

// 7. An expendable environment
node  s7      "7. An expendable environment" (inside top, size: large)                                                                                                shape: none  layout: row (gap: wide, align-children: top)       below s6     left even with s0
node  s7.h    "On your own host" (outside top, size: large)                                                                                                           style: step  layout: column (align-children: left, gap: tight)  width: s3.h  gather-children: left
node  s7.h.a  "⌨️ Have a place ready where seats run their tests and throw it away after: a disposable container or jail, a test VM, or a cloud sandbox." (wrap: 60)  style: do
node  s7.h.b  "⌨️ Decide a spending cap you accept for it." (wrap: 60)                                                                                                style: do
node  s7.h.c  "The first ticket runs there." (wrap: 70)                                                                                                               style: note
node  s7.s    "In a sandbox session" (outside top, size: large)                                                                                                       style: step  layout: column (align-children: left, gap: tight)  width: s4.s  gather-children: left
node  s7.s.a  "⌨️ Decide a spending cap you accept for the seats' cloud sandboxes." (wrap: 60)                                                                        style: do
node  s7.s.b  "Seats run their tests in a child jail or a cloud sandbox, never in the session itself." (wrap: 70)                                                     style: note
